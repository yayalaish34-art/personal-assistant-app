# Postgres (docker-compose reads these)
POSTGRES_USER=pa_user
POSTGRES_PASSWORD=changeme_local
POSTGRES_DB=personal_assistant

# App
# DATABASE_URL is optional: the AI routes (/parse, /transcribe, /voice/*) are
# stateless. Set it only to run the database-backed routes and the job queue.
DATABASE_URL=postgresql://pa_user:changeme_local@localhost:5432/personal_assistant?schema=public
PORT=5000
# Unset means production. That is deliberate — a deploy that forgets this gets
# the locked-down behaviour, not the open one.
NODE_ENV=development
LOG_LEVEL=info

# Auth
# Both must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_a_32_char_or_longer_random_secret
JWT_REFRESH_SECRET=replace_me_with_a_different_32_char_or_longer_secret
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
# POST /auth/dev — signs in as the seeded local account with no OAuth round
# trip. Takes NODE_ENV=development as well as this flag; anywhere else the
# route is not mounted and returns 404. Never set this in a deployment.
ENABLE_DEV_AUTH=true

# LLM + Speech
OPENAI_API_KEY=

# Voice assistant (text-to-speech). Without a key she still answers, silently.
# Only eleven_v3 speaks Hebrew — the flash/turbo models do not.
ELEVENLABS_API_KEY=
# Defaults: "Jessica — Playful, Bright, Warm", eleven_v3 for Hebrew/Arabic and
# eleven_flash_v2_5 (faster) for the languages it supports.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_FAST_MODEL_ID=

# Push
EXPO_ACCESS_TOKEN=

# Security
# Comma-separated allowlist of origins for CORS. Empty allows all (dev only).
# REQUIRED in production — the server refuses to start without it.
CORS_ORIGINS=
