# Postgres (docker-compose reads these)
POSTGRES_USER=pa_user
POSTGRES_PASSWORD=changeme_local
POSTGRES_DB=personal_assistant

# App
DATABASE_URL=postgresql://pa_user:changeme_local@localhost:5432/personal_assistant?schema=public
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Auth
# Both must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me_with_a_32_char_or_longer_random_secret
JWT_REFRESH_SECRET=replace_me_with_a_different_32_char_or_longer_secret
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# LLM + Speech
OPENAI_API_KEY=

# Push
EXPO_ACCESS_TOKEN=

# Security
# Comma-separated allowlist of origins for CORS. Empty allows all (dev only).
# REQUIRED in production — the server refuses to start without it.
CORS_ORIGINS=
