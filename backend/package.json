{
  "name": "personal-assistant-backend",
  "version": "1.0.0",
  "description": "Express backend for the personal assistant app",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:local": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "start:migrate": "prisma migrate deploy && node dist/index.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/multer": "^2.2.0",
    "cors": "^2.8.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "jose": "^6.2.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "openai": "^6.49.0",
    "pg-boss": "^12.26.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
