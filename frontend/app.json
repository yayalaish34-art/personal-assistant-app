{
  "expo": {
    "name": "Personal Assistant",
    "slug": "personal-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "personalassistant",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yayalaish34art.personalassistant",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "The assistant needs the microphone to hear what you say.",
        "NSLocationWhenInUseUsageDescription": "The assistant uses your location to give directions, suggest meeting places, and know which city you are in.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "The assistant detects when you arrive at a meeting location to give you a timely heads-up.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.yayalaish34art.personalassistant",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "The assistant detects when you arrive at a meeting location to give you a timely heads-up.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-localization",
      "expo-notifications",
      "expo-font",
      "expo-status-bar",
      "expo-task-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "9d0ed029-d6a3-4843-ba50-6e7e65a6ac9c"
      }
    },
    "owner": "yaya07446st"
  }
}
