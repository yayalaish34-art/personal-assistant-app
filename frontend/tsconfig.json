{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // No baseUrl: TypeScript 6 deprecates it, and "paths" already resolves
    // relative to this file, which is what the alias below needs.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
